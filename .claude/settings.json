{
    "$schema": "https://json.schemastore.org/claude-code-settings.json",
    "permissions": {
        "deny": [
            "Read(.env)",
            "Read(.env.*)",
            "Read(!.env.example)",
            "Edit(/.claude/settings.json)",
            "Bash(git push *--force*)",
            "Bash(git push -f*)",
            "Bash(git push * -f)",
            "Bash(git push * -f *)",
            "Bash(git push *+*)",
            "Bash(git push *--no-verify*)",
            "Bash(git commit *--no-verify*)",
            "Bash(git commit -n*)",
            "Bash(git reset --hard*)",
            "Bash(git clean -f*)"
        ],
        "ask": [
            "Edit(/.husky/**)",
            "Edit(/.github/workflows/**)",
            "Edit(/.github/ruleset.json)",
            "Edit(/scripts/gate-tiers.json)",
            "Edit(/stryker.config.json)",
            "Edit(/.npmrc)",
            "Edit(/next.config.ts)",
            "Edit(/proxy.ts)",
            "Edit(/scripts/gate-*.mjs)",
            "Edit(/scripts/check-*.mjs)",
            "Edit(/scripts/docs-check*.mjs)",
            "Edit(/scripts/audit-gate*.mjs)",
            "Edit(/scripts/verify-*.mjs)",
            "Edit(/scripts/ensure-playwright*.mjs)",
            "Edit(/scripts/run-on-free-port*.mjs)",
            "Edit(/scripts/gate-files.json)",
            "Edit(/scripts/audit-allowlist.json)",
            "Edit(/scripts/lock-age-allowlist.json)",
            "Edit(/scripts/version-holds.json)",
            "Edit(/scripts/bundle-budget.json)",
            "Edit(/vitest.config.ts)",
            "Edit(/playwright.config.ts)",
            "Edit(/playwright.dev.config.ts)",
            "Edit(/shared/lib/test-utils/setup.ts)",
            "Edit(/tsconfig*.json)",
            "Edit(/eslint.config.js)",
            "Edit(/.oxlintrc.json)",
            "Edit(/.prettierrc.json)",
            "Edit(/.prettierignore)",
            "Edit(/.editorconfig)",
            "Edit(/commitlint.config.mjs)",
            "Edit(/.nvmrc)",
            "Edit(/.cursor/rules/**)",
            "Edit(/AGENTS.md)",
            "Edit(/CLAUDE.md)",
            "Edit(/e2e/support/**)",
            "Edit(/scripts/mutation-scope.test.mjs)",
            "Edit(/scripts/bench-verify.test.mjs)"
        ]
    }
}
