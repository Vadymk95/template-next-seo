# Optional: Upstash Redis for distributed API rate limits (proxy).
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Rate limit client identity: vercel | first-hop | none (unset: vercel on Vercel, else none).
# RATE_LIMIT_TRUST_PROXY=

# REQUIRED in production builds: public base URL of the app.
# Drives metadataBase, sitemap.xml URLs, robots.txt sitemap line, hreflang
# alternates, Server Actions allowedOrigins, Playwright baseURL.
# `shared/lib/env.ts` REJECTS the build if missing OR if it contains
# localhost / 127.0.0.1 in production — a silent localhost fallback would bake
# into prerendered SEO surfaces and destroy crawl ranking.
#
# `next dev` needs NOTHING here: the schema defaults to http://localhost:3000
# outside production. This value exists so that `cp .env.example .env.local`
# makes `npm run verify` (which builds) pass. A localhost value here would be
# rejected by the very check above — that is why the default below is not one.
#
# `.invalid` is reserved by RFC 6761 and never resolves, so it can never become
# an accidental real deploy. Replace it with your origin per environment.
NEXT_PUBLIC_APP_URL=https://template-next-seo.invalid
