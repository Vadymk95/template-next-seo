/node_modules
/.pnp
.pnp.js
.yarn/install-state.gz

# testing
/coverage
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/

# Stryker mutation testing (the incremental report is a local/CI cache, not a source)
/.stryker-tmp/
/reports/

# next.js
/.next/
/.next-dev/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env*.local
.env

# vercel
.vercel

# typescript
*.tsbuildinfo
.eslintcache
.prettiercache
next-env.d.ts

# bundle analyzer
.next/analyze/

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Logs
logs
*.log
pnpm-debug.log*

# Temporary files
*.tmp
*.temp
.cache/

# .cursor/ is tracked in this template (personal repo) — override the global
# ghost-mode ignore (~/.gitignore_global) so plain `git add` works for agents.
!.cursor/
!.cursor/**

# .claude/commands/ holds the repo's own agent commands and is tracked for the
# same reason as .cursor/. The directory itself has to be re-included first: the
# global ignore lists `.claude/`, and git will not descend into an ignored
# directory to see a negation inside it. Machine-local settings stay untracked.
!.claude/
!.claude/commands/
!.claude/commands/**
.claude/settings.local.json
.claude/settings.json
