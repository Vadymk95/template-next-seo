# Optional nvm version switch (.nvmrc). Fenced with set +e: husky runs hooks
# under `sh -e`, and nvm re-arms errexit internally before returning non-zero —
# without the fence a missing nvm version kills the hook before its real work.
export NVM_DIR="${NVM_DIR:-$HOME/.nvm}"
if [ -s "$NVM_DIR/nvm.sh" ]; then
    set +e
    . "$NVM_DIR/nvm.sh" > /dev/null 2>&1
    nvm use --silent > /dev/null 2>&1
    set -e
fi

# Match CI: build + Playwright prod server need a base URL.
export NEXT_PUBLIC_APP_URL="${NEXT_PUBLIC_APP_URL:-https://template-next-seo.invalid}"

# verify:push is PHASE-AWARE (scripts/verify-push.mjs reads scripts/gate-tiers.json):
# phase 0 (scaffold, pre-deploy) runs audit + hooks + format + tsc + lint + coverage and
# loudly SKIPS build/e2e/smoke — no prod boundary exists yet to guard; phase 1 (deployed)
# runs the full verify:ci chain. Pushing implies network, so the audit gate runs in both.
# GATE_PHASE=full forces the full chain (how gate machinery itself gets pushed).
echo "→ verify:push (phase-aware gate — see scripts/gate-tiers.json)"
npm run verify:push || {
    echo "❌ verify:push failed. Fix before push."
    echo "   Lint or formatting: npm run fix && git add -u"
    echo "   Playwright browsers are installed by scripts/ensure-playwright.mjs"
    echo "   Touched routing, i18n or next.config.ts? Also run: npm run verify:full"
    echo "   Port 3000 busy? The gate kills its own stray servers; a foreign one: PORT=3100 PLAYWRIGHT_BASE_URL=http://localhost:3100 npm run verify:ci"
    exit 1
}
