{
    "name": "template-next-seo",
    "version": "1.0.0",
    "private": true,
    "type": "module",
    "sideEffects": [
        "**/*.css",
        "**/globals.css"
    ],
    "engines": {
        "node": ">=24.0.0"
    },
    "browserslist": {
        "production": [
            "chrome >= 111",
            "edge >= 111",
            "firefox >= 111",
            "safari >= 16.4"
        ],
        "development": [
            "last 1 chrome version",
            "last 1 firefox version",
            "last 1 safari version"
        ]
    },
    "scripts": {
        "dev": "node scripts/startup.js && next dev --turbo",
        "dev:webpack": "node scripts/startup.js && next dev",
        "dev:clean": "npm run clean && npm run dev",
        "clean": "rm -rf .next",
        "build": "next build --webpack",
        "build:turbo": "next build --turbopack",
        "build:analyze": "ANALYZE=true next build --webpack",
        "start": "next start",
        "lint": "npm run lint:oxlint && eslint . --max-warnings 0",
        "lint:oxlint": "oxlint --config .oxlintrc.json --deny-warnings .",
        "type-check": "npm run typecheck",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "lint:staged": "lint-staged",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:coverage": "vitest run --coverage",
        "test:e2e": "playwright test",
        "test:e2e:ui": "playwright test --ui",
        "test:e2e:headed": "playwright test --headed",
        "test:e2e:install": "playwright install --with-deps chromium",
        "verify:enterprise": "node scripts/check-hooks.mjs && npm run lint && npm run format:check && npm run typecheck && npm run test:coverage && npm run build && node scripts/ensure-playwright.mjs && npm run test:e2e:prod",
        "verify": "npm run verify:enterprise",
        "bench:verify": "node scripts/bench-verify.mjs",
        "prepare": "husky",
        "test:e2e:prod": "CI=true playwright test",
        "typecheck": "tsc --noEmit",
        "fix": "oxlint --config .oxlintrc.json --fix . && eslint . --fix && prettier --write .",
        "audit:gate": "node scripts/audit-gate.mjs",
        "verify:ci": "npm run audit:gate && npm run verify",
        "smoke:dev": "playwright test --config playwright.dev.config.ts",
        "verify:full": "npm run verify:ci && npm run smoke:dev"
    },
    "dependencies": {
        "@hookform/resolvers": "^5.4.0",
        "@radix-ui/react-slot": "^1.3.0",
        "@upstash/ratelimit": "^2.0.8",
        "@upstash/redis": "^1.38.0",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "lucide-react": "^1.24.0",
        "next": "^16.2.11",
        "next-intl": "^4.13.2",
        "react": "^19.2.7",
        "react-dom": "^19.2.7",
        "react-hook-form": "^7.81.0",
        "server-only": "^0.0.1",
        "tailwind-merge": "^3.6.0",
        "web-vitals": "^5.3.0",
        "zod": "^4.4.3",
        "zustand": "^5.0.14"
    },
    "devDependencies": {
        "@commitlint/cli": "^21.2.1",
        "@commitlint/config-conventional": "^21.2.0",
        "@eslint/js": "^10.0.1",
        "@next/bundle-analyzer": "^16.2.11",
        "@playwright/test": "^1.61.1",
        "@tailwindcss/postcss": "^4.3.3",
        "@testing-library/jest-dom": "^6.9.1",
        "@testing-library/react": "^16.3.2",
        "@types/node": "^24.13.3",
        "@types/react": "^19.2.17",
        "@types/react-dom": "^19.2.3",
        "@vitejs/plugin-react": "^6.0.3",
        "@vitest/coverage-v8": "^4.1.7",
        "eslint": "^10.8.0",
        "eslint-config-next": "^16.2.11",
        "eslint-config-prettier": "^10.1.8",
        "eslint-import-resolver-typescript": "^4.4.5",
        "eslint-plugin-import-x": "^4.17.1",
        "eslint-plugin-jsx-a11y": "^6.10.2",
        "eslint-plugin-oxlint": "^1.75.0",
        "eslint-plugin-prettier": "^5.5.6",
        "eslint-plugin-react": "^7.37.5",
        "eslint-plugin-react-hooks": "^7.1.1",
        "eslint-plugin-tailwindcss": "^4.2.0",
        "globals": "^17.7.0",
        "husky": "^9.1.7",
        "jsdom": "^29.1.1",
        "lint-staged": "^17.1.0",
        "oxlint": "~1.75.0",
        "postcss": "^8.5.21",
        "prettier": "^3.9.6",
        "tailwindcss": "^4.3.0",
        "tw-animate-css": "^1.4.0",
        "typescript": "~6.0.3",
        "typescript-eslint": "^8.64.0",
        "vitest": "^4.1.7"
    },
    "overrides": {
        "brace-expansion": ">=5.0.8",
        "fast-uri": ">=3.1.4",
        "next": {
            "postcss": ">=8.5.10"
        },
        "sharp": ">=0.35.0",
        "eslint-plugin-react": {
            "eslint": "$eslint"
        },
        "eslint-plugin-jsx-a11y": {
            "eslint": "$eslint"
        },
        "eslint-plugin-import": {
            "eslint": "$eslint"
        }
    },
    "lint-staged": {
        "*.{ts,tsx,js,jsx}": [
            "oxlint --config .oxlintrc.json --fix",
            "eslint --fix",
            "prettier --write"
        ],
        "*.{json,md,yml,yaml}": [
            "prettier --write"
        ]
    }
}
